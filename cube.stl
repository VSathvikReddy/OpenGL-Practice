solid cube

  // Front (+Z)
  facet normal 0 0 1
    outer loop
      vertex -0.5 -0.5 0.5
      vertex  0.5 -0.5 0.5
      vertex  0.5  0.5 0.5
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex -0.5 -0.5 0.5
      vertex  0.5  0.5 0.5
      vertex -0.5  0.5 0.5
    endloop
  endfacet

  // Back (-Z)
  facet normal 0 0 -1
    outer loop
      vertex  0.5 -0.5 -0.5
      vertex -0.5 -0.5 -0.5
      vertex -0.5  0.5 -0.5
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex  0.5 -0.5 -0.5
      vertex -0.5  0.5 -0.5
      vertex  0.5  0.5 -0.5
    endloop
  endfacet

  // Left (-X)
  facet normal -1 0 0
    outer loop
      vertex -0.5 -0.5 -0.5
      vertex -0.5 -0.5  0.5
      vertex -0.5  0.5  0.5
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex -0.5 -0.5 -0.5
      vertex -0.5  0.5  0.5
      vertex -0.5  0.5 -0.5
    endloop
  endfacet

  // Right (+X)
  facet normal 1 0 0
    outer loop
      vertex 0.5 -0.5  0.5
      vertex 0.5 -0.5 -0.5
      vertex 0.5  0.5 -0.5
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 0.5 -0.5  0.5
      vertex 0.5  0.5 -0.5
      vertex 0.5  0.5  0.5
    endloop
  endfacet

  // Bottom (-Y)
  facet normal 0 -1 0
    outer loop
      vertex -0.5 -0.5 -0.5
      vertex  0.5 -0.5 -0.5
      vertex  0.5 -0.5  0.5
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex -0.5 -0.5 -0.5
      vertex  0.5 -0.5  0.5
      vertex -0.5 -0.5  0.5
    endloop
  endfacet

  // Top (+Y)
  facet normal 0 1 0
    outer loop
      vertex -0.5  0.5  0.5
      vertex  0.5  0.5  0.5
      vertex  0.5  0.5 -0.5
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex -0.5  0.5  0.5
      vertex  0.5  0.5 -0.5
      vertex -0.5  0.5 -0.5
    endloop
  endfacet

endsolid cube